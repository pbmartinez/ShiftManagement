{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ShiftManagement;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "HolidaySettings": {
    "NagerEndpoint": "https://date.nager.at/api/v3/",
    "CacheDuration": "30.00:00:00",
    "Retry": {
      "MaxRetryAttempts": 3,
      "Delay": "00:00:02",
      "BackoffType": "Exponential",
      "UseJitter": true
    }
  }
}
